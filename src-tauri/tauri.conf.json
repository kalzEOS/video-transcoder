{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "Video Transcoder",
  "version": "2.7.1",
  "identifier": "com.kalzi.videotranscoder",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
	"withGlobalTauri": true,
    "windows": [
      {
        "title": "Video Transcoder v2.7.1",
        "width": 1100,
        "height": 915,
        "minWidth": 910,
        "minHeight": 780,
        "center": true,
        "resizable": true,
        "fullscreen": false,
		"devtools": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/256x256.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": [
      "themes/*"
    ]
  },
  "plugins": {}
}
